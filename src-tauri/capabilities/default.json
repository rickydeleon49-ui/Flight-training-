{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by Her Flight Deck.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPCONFIG/documents/**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$APPCONFIG/documents/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://aistudio.google.com/**" },
        { "url": "https://platform.claude.com/settings/keys" },
        { "url": "https://www.faa.gov/pilots/become/faq" },
        { "url": "https://www.faa.gov/faq/when-required-what-class-medical-certificate-must-student-pilot-have" },
        { "url": "https://www.faa.gov/pilots/become/student_cert" }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
