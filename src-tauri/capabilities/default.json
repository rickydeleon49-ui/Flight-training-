{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "platforms": ["macOS", "windows", "linux"],
  "description": "Permissions required by Your Flight Deck.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "notification:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPCONFIG/documents/**" }, { "path": "$APPCACHE/open-copies/**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$APPCONFIG/documents/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
