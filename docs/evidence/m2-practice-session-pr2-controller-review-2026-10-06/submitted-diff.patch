+        .unwrap();
+    let resp_count: i64 = check_conn
+        .query_row(
+            "SELECT COUNT(*) FROM practice_responses WHERE attempt_id IN (?1, ?2)",
+            [&att1_id, &att2_id],
+            |r| r.get(0),
