+    .unwrap();
+
+    let conn2 = Connection::open(dir.path().join("her-flight-deck.db")).unwrap();
+    let (v2_id,): (String,) = conn2
+        .query_row(
+            "SELECT id FROM practice_test_versions WHERE source_material_id = 'mat-erase' AND is_active = 1",
+            [],
+            |r| Ok((r.get(0)?,)),
