+    // 2. Regenerate practice test: new active version v2, v1 becomes inactive
+    let new_questions = serde_json::json!([
+        {
+            "question": "New Question 1",
+            "options": ["Opt A", "Opt B", "Opt C"],
+            "correctIndex": 0,
+            "explanation": "Exp 1"
