--- a/.github/workflows/release.yml	2026-10-04 15:53:05
+++ b/.github/workflows/release.yml	2026-10-04 15:56:24
@@ -232,6 +232,8 @@
       fail-fast: false
       matrix: ${{ fromJSON(needs.check.outputs.matrix) }}
 
+    environment: ${{ matrix.os == 'macos-15' && 'macos-signing' || '' }}
+
     runs-on: ${{ matrix.os }}
     steps:
       - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
@@ -247,14 +249,242 @@
         continue-on-error: true
 
       - run: npm ci
+
+      - name: Check macOS signing prerequisites (fail-closed)
+        if: matrix.os == 'macos-15'
+        shell: bash
+        env:
+          EVENT_NAME: ${{ github.event_name }}
+          REF_NAME: ${{ github.ref_name }}
+          APPLE_CERTIFICATE: ${{ secrets.APPLE_CERTIFICATE }}
+          APPLE_CERTIFICATE_PASSWORD: ${{ secrets.APPLE_CERTIFICATE_PASSWORD }}
+          APPLE_SIGNING_IDENTITY: ${{ secrets.APPLE_SIGNING_IDENTITY }}
+          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
+          APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}
+          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
+          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}
+          APPLE_ID: ${{ secrets.APPLE_ID }}
+          APPLE_PASSWORD: ${{ secrets.APPLE_PASSWORD }}
+        run: |
+          set -eo pipefail
+
+          if [ "$EVENT_NAME" != "workflow_dispatch" ]; then
+            echo "::error::Signed macOS release builds are permitted only via manual workflow_dispatch, not '$EVENT_NAME'."
+            exit 1
+          fi
+
+          if [ "$REF_NAME" != "main" ]; then
+            echo "::error::Signed macOS release builds must be dispatched from main branch, not '$REF_NAME'."
+            exit 1
+          fi
+
+          MISSING=""
+          if [ -z "$APPLE_CERTIFICATE" ]; then MISSING="$MISSING APPLE_CERTIFICATE"; fi
+          if [ -z "$APPLE_CERTIFICATE_PASSWORD" ]; then MISSING="$MISSING APPLE_CERTIFICATE_PASSWORD"; fi
+          if [ -z "$APPLE_SIGNING_IDENTITY" ]; then MISSING="$MISSING APPLE_SIGNING_IDENTITY"; fi
+          if [ -z "$APPLE_TEAM_ID" ]; then MISSING="$MISSING APPLE_TEAM_ID"; fi
+
+          HAS_API_AUTH=true
+          if [ -z "$APPLE_API_KEY" ] || [ -z "$APPLE_API_KEY_P8" ] || [ -z "$APPLE_API_ISSUER" ]; then
+            HAS_API_AUTH=false
+          fi
+
+          HAS_PWD_AUTH=true
+          if [ -z "$APPLE_ID" ] || [ -z "$APPLE_PASSWORD" ]; then
+            HAS_PWD_AUTH=false
+          fi
+
+          if [ "$HAS_API_AUTH" = false ] && [ "$HAS_PWD_AUTH" = false ]; then
+            MISSING="$MISSING (either APPLE_API_KEY+APPLE_API_KEY_P8+APPLE_API_ISSUER or APPLE_ID+APPLE_PASSWORD)"
+          fi
+
+          if [ -n "$MISSING" ]; then
+            echo "::error::Required macOS signing prerequisites are missing from secrets/environment:$MISSING"
+            exit 1
+          fi
+
+      - name: Prepare temporary signing keychain (macOS)
+        if: matrix.os == 'macos-15'
+        shell: bash
+        env:
+          APPLE_CERTIFICATE: ${{ secrets.APPLE_CERTIFICATE }}
+          APPLE_CERTIFICATE_PASSWORD: ${{ secrets.APPLE_CERTIFICATE_PASSWORD }}
+          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
+        run: |
+          set -eo pipefail
+
+          ORIG_KC=$(security list-keychains -d user | tr -d '"' || true)
+          echo "ORIG_KEYCHAINS=$ORIG_KC" >> "$GITHUB_ENV"
+
+          KEYCHAIN_PASSWORD="$(openssl rand -hex 24)"
+          echo "::add-mask::$KEYCHAIN_PASSWORD"
+          KC="$RUNNER_TEMP/hfd-signing.keychain-db"
+          echo "TEMP_KEYCHAIN=$KC" >> "$GITHUB_ENV"
+
+          security create-keychain -p "$KEYCHAIN_PASSWORD" "$KC"
+          security set-keychain-settings -lut 3600 "$KC"
+          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KC"
+
+          echo "$APPLE_CERTIFICATE" | base64 --decode > "$RUNNER_TEMP/cert.p12"
+          security import "$RUNNER_TEMP/cert.p12" -k "$KC" -P "$APPLE_CERTIFICATE_PASSWORD" -T /usr/bin/codesign
+          security set-key-partition-list -S apple-tool:,apple: -k "$KEYCHAIN_PASSWORD" "$KC"
+          rm -f "$RUNNER_TEMP/cert.p12"
+
+          security list-keychains -d user -s "$KC" $ORIG_KC
+
+          if [ -n "$APPLE_API_KEY_P8" ]; then
+            umask 077
+            printf '%s' "$APPLE_API_KEY_P8" > "$RUNNER_TEMP/AuthKey.p8"
+            echo "APPLE_API_KEY_PATH=$RUNNER_TEMP/AuthKey.p8" >> "$GITHUB_ENV"
+          fi
+
       - run: npm run tauri build -- --bundles ${{ matrix.bundles }}
+        env:
+          APPLE_SIGNING_IDENTITY: ${{ matrix.os == 'macos-15' && secrets.APPLE_SIGNING_IDENTITY || '' }}
+          APPLE_TEAM_ID: ${{ matrix.os == 'macos-15' && secrets.APPLE_TEAM_ID || '' }}
+          APPLE_API_ISSUER: ${{ matrix.os == 'macos-15' && secrets.APPLE_API_ISSUER || '' }}
+          APPLE_API_KEY: ${{ matrix.os == 'macos-15' && secrets.APPLE_API_KEY || '' }}
+          APPLE_API_KEY_PATH: ${{ env.APPLE_API_KEY_PATH }}
+          APPLE_ID: ${{ matrix.os == 'macos-15' && secrets.APPLE_ID || '' }}
+          APPLE_PASSWORD: ${{ matrix.os == 'macos-15' && secrets.APPLE_PASSWORD || '' }}
+
+      - name: Verify signature, notarization and staple (strict, read-only)
+        if: matrix.os == 'macos-15'
+        shell: bash
+        env:
+          EXPECTED_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
+          VERSION: ${{ needs.check.outputs.version }}
+        run: |
+          set -eo pipefail
+
+          dmg=$(find src-tauri/target/release/bundle/dmg -name '*_aarch64.dmg' -print -quit)
+          if [ -z "$dmg" ] || [ ! -f "$dmg" ]; then
+            echo "::error::Target macOS DMG was not found in bundle output"
+            exit 1
+          fi
+
+          echo "== Verifying DMG container signature and integrity =="
+          codesign --verify --strict "$dmg"
+          dmg_info=$(codesign -dvv "$dmg" 2>&1)
+          echo "$dmg_info"
 
+          if ! grep -q '^Authority=Developer ID Application:' <<< "$dmg_info"; then
+            echo "::error::DMG container lacks Developer ID Application signing authority"
+            exit 1
+          fi
+
+          if ! grep -q "^TeamIdentifier=$EXPECTED_TEAM_ID$" <<< "$dmg_info"; then
+            echo "::error::DMG container TeamIdentifier does not match approved expected team"
+            exit 1
+          fi
+
+          if ! grep -q '^Timestamp=' <<< "$dmg_info"; then
+            echo "::error::DMG container lacks secure timestamp"
+            exit 1
+          fi
+
+          echo "== Validating DMG notarization ticket and staple =="
+          xcrun stapler validate "$dmg"
+
+          echo "== Mounting DMG read-only to verify packaged application =="
+          m="$RUNNER_TEMP/hfd-verify"
+          mkdir -p "$m"
+          hdiutil attach -quiet -readonly -nobrowse -mountpoint "$m" "$dmg"
+          trap 'hdiutil detach -quiet "$m" 2>/dev/null || true; rmdir "$m" 2>/dev/null || true' EXIT
+
+          app="$m/Her Flight Deck.app"
+          if [ ! -d "$app" ]; then
+            echo "::error::Her Flight Deck.app not found in mounted DMG"
+            exit 1
+          fi
+
+          echo "== Verifying app bundle metadata =="
+          exec_arch=$(file "$app/Contents/MacOS/her-flight-deck")
+          if ! grep -q 'arm64' <<< "$exec_arch"; then
+            echo "::error::Packaged executable is not arm64 architecture"
+            exit 1
+          fi
+
+          APP_ID=$(plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist")
+          if [ "$APP_ID" != "com.herflightdeck.app" ]; then
+            echo "::error::App bundle identifier '$APP_ID' does not match 'com.herflightdeck.app'"
+            exit 1
+          fi
+
+          APP_VER=$(plutil -extract CFBundleShortVersionString raw "$app/Contents/Info.plist")
+          if [ "$APP_VER" != "$VERSION" ]; then
+            echo "::error::App bundle version '$APP_VER' does not match release version '$VERSION'"
+            exit 1
+          fi
+
+          APP_MIN_OS=$(plutil -extract LSMinimumSystemVersion raw "$app/Contents/Info.plist")
+          if [ "$APP_MIN_OS" != "12.0" ]; then
+            echo "::error::App minimum OS '$APP_MIN_OS' does not match policy minimum '12.0'"
+            exit 1
+          fi
+
+          echo "== Verifying app bundle signature, runtime, and authority =="
+          codesign --verify --deep --strict "$app"
+          app_info=$(codesign -dvv "$app" 2>&1)
+          app_flags=$(codesign -dv "$app" 2>&1)
+          echo "$app_info"
+          echo "$app_flags"
+
+          if ! grep -q '^Authority=Developer ID Application:' <<< "$app_info"; then
+            echo "::error::App bundle lacks Developer ID Application signing authority"
+            exit 1
+          fi
+
+          if ! grep -q "^TeamIdentifier=$EXPECTED_TEAM_ID$" <<< "$app_info"; then
+            echo "::error::App bundle TeamIdentifier does not match approved expected team"
+            exit 1
+          fi
+
+          if ! grep -q '^Identifier=com\.herflightdeck\.app$' <<< "$app_info"; then
+            echo "::error::App signing identifier does not match com.herflightdeck.app"
+            exit 1
+          fi
+
+          if ! grep -q 'flags=.*runtime' <<< "$app_flags"; then
+            echo "::error::App bundle lacks hardened runtime flag"
+            exit 1
+          fi
+
+          if ! grep -q '^Timestamp=' <<< "$app_info"; then
+            echo "::error::App bundle lacks secure timestamp"
+            exit 1
+          fi
+
+          echo "== Assessing Gatekeeper policy compliance =="
+          spctl --assess --type execute -vv "$app"
+
+          hdiutil detach -quiet "$m"
+          trap - EXIT
+          rmdir "$m" 2>/dev/null || true
+
       - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
         with:
           name: installer-${{ matrix.name }}
           path: ${{ matrix.pattern }}
           if-no-files-found: error
 
+      - name: Clean up temporary signing credentials and keychain
+        if: always() && matrix.os == 'macos-15'
+        shell: bash
+        run: |
+          CLEANUP_FAILED=0
+          if [ -n "$TEMP_KEYCHAIN" ] && [ -f "$TEMP_KEYCHAIN" ]; then
+            security delete-keychain "$TEMP_KEYCHAIN" 2>/dev/null || { echo "::warning::Failed to delete temporary keychain"; CLEANUP_FAILED=1; }
+          fi
+          if [ -n "$ORIG_KEYCHAINS" ]; then
+            security list-keychains -d user -s $ORIG_KEYCHAINS 2>/dev/null || { echo "::warning::Failed to restore original keychain search list"; CLEANUP_FAILED=1; }
+          fi
+          rm -f "$RUNNER_TEMP/AuthKey.p8" "$RUNNER_TEMP/cert.p12" || CLEANUP_FAILED=1
+          if [ "$CLEANUP_FAILED" -ne 0 ]; then
+            echo "::error::Signing cleanup encountered one or more errors"
+            exit 1
+          fi
+
   publish:
     permissions:
       contents: write
