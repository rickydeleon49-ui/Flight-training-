{
  "name": "her-flight-deck",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "description": "A personal flight-training companion that keeps study, lessons, goals, notes, finances, and next steps organized in one place.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
